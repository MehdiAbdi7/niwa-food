# ============================================================
#  Niwa Food — Backend
#  Copier ce fichier en `.env` et remplacer les valeurs.
#  Ne JAMAIS committer le .env réel.
# ============================================================

# ===== Serveur =====
PORT=5000
# development | production
# production active secure=true et sameSite=none sur le cookie de session
NODE_ENV=development

# ===== MongoDB =====
# Hôte du cluster Atlas, sans le préfixe mongodb+srv://
MONGODB_HOST=cluster0.xxxxx.mongodb.net
MONGODB_DB_NAME=niwa-food
MONGODB_USERNAME=niwa_app
# Les caractères spéciaux sont encodés automatiquement (encodeURIComponent)
MONGODB_PASSWORD=votre_mot_de_passe_atlas
MONGODB_APP_NAME=NiwaFood

# ===== JWT =====
# Générer une clé aléatoire :  openssl rand -base64 48
JWT_SECRET=remplacez_par_une_chaine_aleatoire_de_48_octets_minimum
# Formats acceptés : 30m, 24h, 7d — pilote AUSSI la durée du cookie
JWT_EXPIRES_IN=7d
# À définir UNIQUEMENT si le front et l'API partagent un domaine parent
# (ex: .niwafood.com pour niwafood.com + api.niwafood.com).
# À laisser vide avec Vercel + Render, qui sont sur deux domaines distincts.
# COOKIE_DOMAIN=.niwafood.com

# ===== CORS =====
# Origines autorisées, séparées par des virgules, sans slash final
# Prod : CORS_ORIGIN=https://niwa-food.vercel.app
CORS_ORIGIN=http://localhost:3000
# Autorise https://*.vercel.app (URLs de preview, à hash changeant).
# À laisser sur false en production si l'API sert des données sensibles.
ALLOW_VERCEL_PREVIEWS=false

# ===== QR code =====
# Lu par src/scripts/generateQRCode.ts, qui génère un lien vers /commande
FRONTEND_URL=http://localhost:3000

# ===== Admin =====
# Lues UNIQUEMENT par src/scripts/createAdmin.ts, au premier démarrage.
# Le mot de passe doit contenir au moins 8 caractères, une majuscule,
# une minuscule et un chiffre. À changer dès la première connexion.
SEED_ADMIN_FIRSTNAME=Mehdi
SEED_ADMIN_LASTNAME=Abdi
SEED_ADMIN_EMAIL=admin@niwafood.dz
SEED_ADMIN_TEL=0555000000
SEED_ADMIN_PASSWORD=ChangezMoi2026

# ===== Cloudinary =====
# Tableau de bord Cloudinary > Settings > API Keys
CLOUDINARY_CLOUD_NAME=niwa-food
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=votre_api_secret_cloudinary